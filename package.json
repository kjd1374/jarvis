{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:start": "supabase start --exclude studio,realtime,imgproxy,mailpit,postgres-meta,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "deploy:preview": "node --use-env-proxy scripts/deploy-preview.mjs --deploy",
    "deploy:production": "vercel --prod",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=safari",
    "test:storage": "playwright test --project=storage",
    "test:all": "playwright test",
    "test:report": "playwright show-report",
    "test:release": "node --test tests/release.test.mjs",
    "test:domain": "playwright test -c playwright.domain.config.ts",
    "test:server": "node scripts/test-server-storage.mjs",
    "deploy:preview:plan": "node scripts/deploy-preview.mjs --dry-run",
    "deploy:preview:resume": "node --use-env-proxy scripts/deploy-preview.mjs --resume",
    "test:deploy": "node --test tests/deploy-preview.test.mjs",
    "test:devices": "node --test tests/devices.test.mjs",
    "test:automation": "node --test tests/development-runtime.test.mjs tests/automation-runner.test.mjs tests/project-work-runner.test.mjs tests/preview-runtime.test.mjs tests/document-runner.test.mjs tests/remote-preview.test.mjs tests/preview-cli.test.mjs tests/provision.test.mjs tests/planning-runner.test.mjs",
    "test:preview": "node scripts/test-preview-runtime.mjs",
    "test:remote-preview": "node --test tests/remote-preview.browser.test.mjs",
    "runtime:manifest": "node scripts/update-runtime-manifest.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "2.120.0",
    "typescript": "^5",
    "vercel": "63.1.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0"
}
