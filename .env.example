# Copy to .env.local and fill in values from Supabase Project Settings > API.
# Local development: use the local API URL and public key from supabase status.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep disabled until app identity, RLS migration and private files are reviewed.
# This flag alone does not provide an authenticated account session.
JARVIS_CLOUD_STORAGE_ENABLED=false
JARVIS_APP_ORIGIN=http://localhost:3000

# CLI credentials belong in secure environment settings, never in Git.
# Optional management/deployment: SUPABASE_ACCESS_TOKEN, VERCEL_TOKEN.

# Optional Google Sheets/Picker browser integration. Public identifiers only.
# Restrict the browser key to the application's HTTP referrer and Picker API.
# Never put an OAuth client secret or access/refresh token here.
GOOGLE_CLIENT_ID=
GOOGLE_BROWSER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Server-only Ed25519 PKCS8 DER key encoded as base64. Used only to issue
# one-time, device-approved preview tickets; never prefix with NEXT_PUBLIC_.
JARVIS_PREVIEW_SIGNING_KEY=
