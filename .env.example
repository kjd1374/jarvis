# Copy to .env.local and fill in values from Supabase Project Settings > API.
# Local development: use the local API URL and public key from supabase status.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# CLI credentials belong in secure environment settings, never in Git.
# Optional management/deployment: SUPABASE_ACCESS_TOKEN, VERCEL_TOKEN.
